POSTGRES_USER=rmp_local
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=remember_my_pill
DATABASE_URL=postgres://rmp_local:CHANGE_ME_LOCAL_ONLY@localhost:5433/remember_my_pill?sslmode=disable
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
# B2B-Prep accepts this pilot-draft consent where supplied, but retains legacy
# compatibility until PILOT_LEGAL_CONTENT_APPROVED is explicitly true.
CONSENT_VERSION=waitlist-consent-v1
# Default OFF. This flag enables required-consent enforcement only; it does not
# publish legal approval, enable B3 routes, referral flows, or send Postmark email.
PILOT_LEGAL_CONTENT_APPROVED=false
# Comma-separated direct reverse-proxy CIDRs; blank means do not trust proxy headers.
TRUSTED_PROXY_CIDRS=
# B3B-Infra defaults to a no-network fake. Use postmark only after a sender
# signature, an approved status-access template, and B3 activation approval.
EMAIL_PROVIDER=fake
EMAIL_FROM_ADDRESS=status@remembermypill.com
EMAIL_FROM_NAME=Remember My Pill
STATUS_ACCESS_BASE_URL=https://remembermypill.com
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Leave blank until final approved email copy/template exists.
POSTMARK_STATUS_ACCESS_TEMPLATE=
# B3C browser-session foundation. Production defaults are secure and use the
# __Host-rmp-status cookie; only explicit local HTTP development may disable it.
RMP_ENVIRONMENT=development
STATUS_SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
