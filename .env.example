POSTGRES_USER=rmp_local
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=remember_my_pill
DATABASE_URL=postgres://rmp_local:CHANGE_ME_LOCAL_ONLY@localhost:5433/remember_my_pill?sslmode=disable
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
# Keep blank during B2A until the approved legal consent version is available.
CONSENT_VERSION=
# Comma-separated direct reverse-proxy CIDRs; blank means do not trust proxy headers.
TRUSTED_PROXY_CIDRS=
# B3B-Infra defaults to a no-network fake. Use postmark only after a sender
# signature, an approved status-access template, and B3 activation approval.
EMAIL_PROVIDER=fake
EMAIL_FROM_ADDRESS=status@remembermypill.com
EMAIL_FROM_NAME=Remember My Pill
STATUS_ACCESS_BASE_URL=https://remembermypill.com
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Leave blank until final approved email copy/template exists.
POSTMARK_STATUS_ACCESS_TEMPLATE=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
